# ─── Community Hub (hub-server.js / Prisma / Coolify) ──────────────────────
# PostgreSQL connection string for the Community Hub.
# Supports Neon, Supabase, Railway, Coolify-managed PostgreSQL, or any standard
# PostgreSQL instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jtl_hub?schema=public"

# Hub server port (optional, default: 3002)
HUB_PORT=3002

# Comma-separated list of allowed CORS origins.
# Leave empty / unset to allow all origins (recommended for a public hub).
# ALLOWED_ORIGINS=https://jtl.yourdomain.com

# Shared secret required to call destructive/admin hub routes (e.g. DELETE a
# flow) via the `x-admin-key` header. Unset = those routes are disabled.
# HUB_ADMIN_KEY=

# Reverse-proxy hops in front of the hub (Coolify/Traefik/nginx). Needed so
# rate limits are per client IP instead of per proxy. Default: 1 in
# production, off otherwise. Set "false" to disable.
# TRUST_PROXY=1

# ─── MSSQL bridge policy ───────────────────────────────────────────────────
# May the bridge connect to loopback / LAN / link-local SQL Servers?
#   hub-server.js (public hub, NODE_ENV=production) → default false
#   server.js (local dev) + selfhost-server.js       → default true
# BRIDGE_ALLOW_PRIVATE_HOSTS=true

# Bridge timeouts + caps (milliseconds / rows / characters)
# BRIDGE_CONNECT_TIMEOUT_MS=15000
# BRIDGE_REQUEST_TIMEOUT_MS=60000
# BRIDGE_MAX_ROWS=5000
# BRIDGE_MAX_SQL_LEN=20000

# Folder where Settings → "Struktur aus Datenbank übernehmen" stores exported schemas
# (<version>.json). Unset = nothing is written on the server, the browser downloads the file.
# Set it only for single-user setups (desktop app does it itself), never on a public hub.
# BRIDGE_SCHEMA_WRITE_DIR=./versions

# ─── Vite build variables (baked into the JS bundle at build time) ──────────
# Empty string (default) = bridge routes are on the same origin as the hub.
# Set only if you run the bridge on a completely separate host/port.
VITE_BRIDGE_URL=

# Hub the frontend talks to for Community browsing/publishing.
# Defaults to the general public hub — swap it for your own hub's URL (or
# leave empty for same-origin, if you're running the combined self-host
# image with your own DATABASE_URL) if you don't want to use ours.
VITE_HUB_URL=https://db-flow.remotatech.com

# Local MSSQL bridge port used in development (default: 3001)
PORT=3001

# ─── MSSQL credentials ─────────────────────────────────────────────────────
# Do NOT add MSSQL credentials here.
# Enter host / port / instance / user / password in the browser under
# „Verbindung“ — they are encrypted with AES-256-GCM and stored only in the
# browser. They are sent to the bridge with every query and never persisted
# server-side. Use a READ-ONLY SQL login: the bridge only ever runs SELECT.
